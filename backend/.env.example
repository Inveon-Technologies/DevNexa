# Copy to .env for local development. All settings use the DEVNEXA_ prefix.
DEVNEXA_DATABASE_URL=sqlite:///./devnexa.db
# simulated (no Docker needed) | live (docker-compose stack)
DEVNEXA_ENVIRONMENT_MODE=simulated
DEVNEXA_SIM_STEP_DELAY=0.8
# heuristic (offline) | anthropic | openai (any OpenAI-compatible endpoint, e.g. Ollama)
DEVNEXA_LLM_PROVIDER=heuristic
DEVNEXA_LLM_MODEL=claude-sonnet-5-5
DEVNEXA_LLM_API_KEY=
DEVNEXA_LLM_BASE_URL=
# Shared secret for GitHub webhooks (HMAC) and the GitHub Actions stage reporter
DEVNEXA_GITHUB_WEBHOOK_SECRET=
# Deploy from GitHub: admin key for the deploy page/API, and the domain apps are served under (*.domain DNS)
DEVNEXA_ADMIN_TOKEN=
# Sign in with GitHub: an OAuth app's client id/secret. Register the callback
# <DEVNEXA_PUBLIC_URL>/api/auth/github/callback. Many people can sign in; each sees only their own apps.
DEVNEXA_GITHUB_CLIENT_ID=
DEVNEXA_GITHUB_CLIENT_SECRET=
# approval (an admin approves new accounts on the Users page) | open (anyone with GitHub) | invite (listed only)
DEVNEXA_GITHUB_SIGNUP=approval
# Pre-approved logins (comma separated). The first one is the server owner (an admin) unless
# DEVNEXA_GITHUB_ADMINS is set; with both empty, the first account that ever signs in is the owner.
DEVNEXA_GITHUB_ALLOWED_USERS=
DEVNEXA_GITHUB_ADMINS=
# Per-member limits (0 = no limit). Admins have none.
DEVNEXA_USER_MAX_APPS=10
DEVNEXA_USER_MAX_SERVERS=5
DEVNEXA_PUBLIC_URL=
DEVNEXA_APPS_DOMAIN=
# Live pipelines: really build/test/deploy the sample app (pushed commit of this repo, else this checkout).
# The repo is also read for the "recent commits" incident evidence when GitHub is connected.
DEVNEXA_SAMPLE_APP_SRC=
DEVNEXA_GITHUB_REPO=
